RESEND_API_KEY=
# Sender shown in the From: header.
#
# Leave blank to use Resend's sandbox sender `onboarding@resend.dev`,
# which delivers to the Resend account owner's own address (the office
# inbox at info@jetset.com.cy). Once jetset-travel.com is verified in
# the Resend dashboard (DKIM + SPF records added to DNS), set this to
# a verified sender such as `JetSet Travel <noreply@jetset-travel.com>`
# to remove the sandbox branding from outgoing mail.
RESEND_FROM_EMAIL=
# Inbox that receives new-lead notifications (defaults to info@jetset.com.cy).
# With the sandbox sender above, this MUST be the Resend account owner's
# email — anything else is rejected with a 403.
CONTACT_EMAIL=info@jetset.com.cy
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Search engine verification — token from Google Search Console
# (emitted as <meta name="google-site-verification"> when set).
GOOGLE_SITE_VERIFICATION=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-RD25ZDGW5H
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
