# Required for enquiry acceptance in production. Missing/failed delivery returns 503.
RESEND_API_KEY=
# Sender shown in From:; defaults to JetSet Travel <quotes@jetset-travel.com>.
# Verify the sending domain with Resend before deploying. An unverified sender
# may fall back to Resend's sandbox, which can only reach the account owner.
RESEND_FROM_EMAIL=
# Inbox that receives new-lead notifications (defaults to info@jetset.com.cy).
CONTACT_EMAIL=info@jetset.com.cy
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
# Production requires a matching reCAPTCHA v3 site key and secret. Configure the
# public key before building. Tokens must match each form's action and hostname.
# Add explicit preview hostnames here AND in Google's key settings to test previews.
RECAPTCHA_ALLOWED_HOSTNAMES=www.jetset-travel.com,jetset-travel.com

# Shared production rate limiting (recommended; absent credentials skip this layer).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Search engine verification — token from Google Search Console
# (emitted as <meta name="google-site-verification"> when set).
GOOGLE_SITE_VERIFICATION=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-RD25ZDGW5H
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
