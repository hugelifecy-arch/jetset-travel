RESEND_API_KEY=
# Sender shown in the From: header.
#
# IMPORTANT: the default onboarding@resend.dev sender is a *sandbox*
# sender — Resend only lets it deliver to the email address of the
# Resend account owner. On production you MUST verify a domain in the
# Resend dashboard and set this to an address on that domain, e.g.
# "JetSet Travel <noreply@jetset-travel.com>". Otherwise notification
# emails to CONTACT_EMAIL will be rejected and leads will only appear
# in server logs under the [LEAD_DELIVERY_FAILED] prefix.
RESEND_FROM_EMAIL=JetSet Travel <onboarding@resend.dev>
# Inbox that receives new-lead notifications (defaults to info@jetset.com.cy)
CONTACT_EMAIL=info@jetset.com.cy
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Search engine verification — token from Google Search Console
# (emitted as <meta name="google-site-verification"> when set).
GOOGLE_SITE_VERIFICATION=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-RD25ZDGW5H
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
